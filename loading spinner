cd /var/www/pterodactyl && \
cp resources/scripts/components/elements/Spinner.tsx resources/scripts/components/elements/Spinner.tsx.bak && \
python3 - <<'PY'
from pathlib import Path

p = Path("resources/scripts/components/elements/Spinner.tsx")
s = p.read_text()

start = s.index("const spin = keyframes`")
end = s.index("const Spinner: Spinner =", start)

new = r"""const spin = keyframes`
    0% {
        transform: rotate(0deg);
    }
    100% {
        transform: rotate(360deg);
    }
`;

const SpinnerComponent = styled.div<Props>`
    ${tw`w-8 h-8`};
    border-style: solid;
    border-radius: 50%;
    animation: ${spin} 0.8s linear infinite;

    ${(props) =>
        props.size === 'small'
            ? tw`w-4 h-4 border-2`
            : props.size === 'large'
            ? css`
                  ${tw`w-16 h-16`};
                  border-width: 5px;
              `
            : null};

    border-color: ${(props) =>
        props.isBlue
            ? 'rgba(59, 130, 246, 0.18)'
            : 'rgba(255, 255, 255, 0.12)'};

    border-top-color: ${(props) =>
        props.isBlue
            ? '#38bdf8'
            : '#38bdf8'};

    border-right-color: ${(props) =>
        props.isBlue
            ? 'rgba(56, 189, 248, 0.65)'
            : 'rgba(56, 189, 248, 0.65)'};

    box-shadow:
        0 0 8px rgba(56, 189, 248, 0.25),
        0 0 18px rgba(37, 99, 235, 0.12);
`;

"""

s = s[:start] + new + s[end:]
p.write_text(s)
PY

echo "===== UPDATED SPINNER =====" && \
sed -n '1,115p' resources/scripts/components/elements/Spinner.tsx && \
echo "===== BUILD =====" && \
yarn build:production
